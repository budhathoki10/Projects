/**
 * Writes src/app/colors.css: the primitive colour scales Shortlist's design tokens are built
 * from (Radix Colors, MIT). Light scales on :root, dark ones under prefers-color-scheme.
 *   npx tsx scripts/gen-colors.mts
 */
import { writeFile } from "node:fs/promises";
import * as radix from "@radix-ui/colors";

const SCALES = ["sand", "jade", "tomato", "amber"] as const;

const block = (dark: boolean) =>
  SCALES.flatMap((name) => {
    const scale = (radix as unknown as Record<string, Record<string, string>>)[dark ? `${name}Dark` : name];
    return Array.from({ length: 12 }, (_, i) => `  --${name}-${i + 1}: ${scale[`${name}${i + 1}`]};`);
  }).join("\n");

const css = `/* Generated by scripts/gen-colors.mts from @radix-ui/colors (MIT). Don't edit by hand. */
/* Steps: 1-2 backgrounds, 3-5 fills, 6-8 borders, 9-10 solids, 11 low-contrast text, 12 text. */
:root {
${block(false)}
}

@media (prefers-color-scheme: dark) {
  :root {
${block(true)
  .split("\n")
  .map((l) => `  ${l}`)
  .join("\n")}
  }
}
`;
await writeFile(new URL("../src/app/colors.css", import.meta.url), css);
console.log("Wrote src/app/colors.css");
