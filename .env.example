# --- Core ---
# Any Postgres works (Neon, Supabase, Railway, local).
DATABASE_URL=postgres://shortlist:shortlist@localhost:5432/shortlist
# Public URL of the app, used in email links and payment return URLs.
APP_URL=http://localhost:3000
# Protects /api/cron-job/* (the URL cron-job.org calls). Long and random: openssl rand -hex 32
CRON_JOB_SECRET=

# --- Legal pages (shown on /terms, /privacy, /refund; Paddle checks these) ---
LEGAL_OPERATOR_NAME=Your Name or Business Name
LEGAL_COUNTRY=Nepal
SUPPORT_EMAIL=support@yourdomain.com

# --- AI (Claude). Without a key, plain-code fallbacks run: they work, but tailoring only reorders. ---
ANTHROPIC_API_KEY=
# Optional overrides. Reading CVs and job posts uses a fast model; writing uses the strongest.
AI_READ_MODEL=claude-haiku-5-5
AI_WRITE_MODEL=claude-opus-5-5

# --- Email via https://resend.com (confirmations, password resets, follow-up reminders) ---
RESEND_API_KEY=
EMAIL_FROM=Shortlist <hello@yourdomain.com>
# Without RESEND_API_KEY, emails are printed to the console in development,
# or written to this file (JSON lines) when it is set. Tests use it.
EMAIL_DEV_OUTBOX=

# --- Payments: Paddle (USD, one-time passes) ---
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# One-time prices: $15 for 30 days and $35 for 90 days. The webhook reads days from these ids.
NEXT_PUBLIC_PADDLE_PRICE_30=
NEXT_PUBLIC_PADDLE_PRICE_90=
PADDLE_WEBHOOK_SECRET=

# --- Payments: Khalti (NPR, Nepal) ---
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
KHALTI_PASS_30_NPR=1500
KHALTI_PASS_90_NPR=3500
